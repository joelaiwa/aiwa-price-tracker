# ─── Twilio (WhatsApp notifications) ─────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio sandbox number (for testing) or your approved WhatsApp sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your WhatsApp number (Mexico format)
# Example: whatsapp:+5215512345678  (52 = Mexico country code, 1 = mobile prefix)
TWILIO_WHATSAPP_TO=whatsapp:+521XXXXXXXXXX

# ─── Tracker settings ─────────────────────────────────────────────────────────
# How often to check prices (in minutes). 60 = every hour.
CHECK_INTERVAL_MINUTES=60
